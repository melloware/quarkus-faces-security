<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.melloware</groupId>
    <artifactId>quarkus-faces-security</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>
    <name>quarkus-faces-security</name>
    <description>Quarkus + Jakarta Faces demo of form login, HTTP Basic auth (embedded users) and OIDC (Keycloak) security</description>
    <url>https://github.com/melloware/quarkus-faces-security</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <myfaces.version>4.1.4</myfaces.version>
        <omnifaces-quarkus.version>5.5.6</omnifaces-quarkus.version>
        <primefaces-quarkus.version>4.16.1</primefaces-quarkus.version>
        <quarkus.version>3.40.1.1</quarkus.version>
        <surefire.version>3.5.4</surefire.version>
        <build-helper.version>3.6.1</build-helper.version>
        <!-- JUnit 5 tag(s) to run; each security profile switches this to its own tag -->
        <test.groups>unsecured</test.groups>
        <!-- @QuarkusIntegrationTest (*IT) classes only run in native mode: mvn verify -Dnative -->
        <skipITs>true</skipITs>
        <!-- -Dnative.surefire.skip : skip the JVM (@QuarkusTest) tests in a native build, as Quarkus extensions do -->
        <native.surefire.skip>false</native.surefire.skip>
        <!-- Config profile for a native build (the security profiles switch it to form / basic / oidc) -->
        <app.profile>prod</app.profile>
        <playwright-quarkus.version>2.4.0</playwright-quarkus.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus.platform</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Faces -->
        <dependency>
            <groupId>org.apache.myfaces.core.extensions.quarkus</groupId>
            <artifactId>myfaces-quarkus</artifactId>
            <version>${myfaces.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.primefaces</groupId>
            <artifactId>quarkus-primefaces</artifactId>
            <version>${primefaces-quarkus.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.omnifaces</groupId>
            <artifactId>quarkus-omnifaces</artifactId>
            <version>${omnifaces-quarkus.version}</version>
        </dependency>
        <dependency>
            <!-- extra themes: arya-blue is used for dark mode (saga-blue ships with PrimeFaces) -->
            <groupId>org.primefaces</groupId>
            <artifactId>primefaces-themes</artifactId>
            <version>16.0.1</version>
        </dependency>
        <dependency>
            <groupId>org.mvnpm</groupId>
            <artifactId>primeflex</artifactId>
            <version>4.0.0</version>
            <scope>runtime</scope>
        </dependency>

        <!--
          Security core only (SecurityIdentity, HTTP permissions). The actual mechanism is added
          by a Maven profile, so each mode only carries the JARs it needs:
            -Pform  -> quarkus-elytron-security-properties-file (form login page)
            -Pbasic -> quarkus-elytron-security-properties-file (HTTP Basic auth)
            -Poidc  -> quarkus-oidc (+ quarkus-jackson) and the extra src/main/oidc sources
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-security</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.playwright</groupId>
            <artifactId>quarkus-playwright</artifactId>
            <version>${playwright-quarkus.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <!-- Only run the tests for the active mode: unsecured | form | basic | oidc -->
                    <groups>${test.groups}</groups>
                    <skipTests>${native.surefire.skip}</skipTests>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <!-- Runs the *IT classes against the packaged app (the native executable with -Dnative) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <groups>${test.groups}</groups>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- mvn -Pform : Faces login page (form auth) backed by embedded users -->
            <!--   mvn -Pform verify : run only the form login tests                    -->
            <id>form</id>
            <properties>
                <quarkus.profile>dev,form</quarkus.profile>
                <test.groups>form</test.groups>
                <app.profile>form</app.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-elytron-security-properties-file</artifactId>
                </dependency>
            </dependencies>
            <build>
                <defaultGoal>clean quarkus:dev</defaultGoal>
            </build>
        </profile>
        <profile>
            <!-- mvn -Pbasic : HTTP Basic authentication (the browser's own login dialog), embedded users -->
            <!--   mvn -Pbasic verify : run only the Basic auth tests                                     -->
            <id>basic</id>
            <properties>
                <quarkus.profile>dev,basic</quarkus.profile>
                <test.groups>basic</test.groups>
                <app.profile>basic</app.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-elytron-security-properties-file</artifactId>
                </dependency>
            </dependencies>
            <build>
                <defaultGoal>clean quarkus:dev</defaultGoal>
            </build>
        </profile>
        <profile>
            <!-- mvn -Poidc : OIDC authorization code flow against Keycloak Dev Services (needs Docker) -->
            <!--   mvn -Poidc verify : run only the OIDC tests                                         -->
            <id>oidc</id>
            <properties>
                <quarkus.profile>dev,oidc</quarkus.profile>
                <test.groups>oidc</test.groups>
                <app.profile>oidc</app.profile>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-oidc</artifactId>
                </dependency>
                <dependency>
                    <!-- OIDC parses Keycloak's JSON metadata via Vert.x, which needs Jackson on the classpath -->
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jackson</artifactId>
                </dependency>
            </dependencies>
            <build>
                <defaultGoal>clean compile quarkus:dev</defaultGoal>
                <plugins>
                    <plugin>
                        <!-- Code that touches OIDC APIs (JsonWebToken) lives in src/main/oidc/java
                             and is only compiled when this profile is active -->
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${build-helper.version}</version>
                        <executions>
                            <execution>
                                <id>add-oidc-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>src/main/oidc/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <!-- @QuarkusIntegrationTest starts Keycloak Dev Services from the test JVM, which
                             does not read application-oidc.properties. Without these it imports the default
                             "quarkus" realm instead of ours. Keep in sync with application-oidc.properties. -->
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <quarkus.keycloak.devservices.realm-path>quarkus-faces-realm.json</quarkus.keycloak.devservices.realm-path>
                                <quarkus.keycloak.devservices.realm-name>quarkus-faces</quarkus.keycloak.devservices.realm-name>
                                <quarkus.oidc.client-id>quarkus-faces</quarkus.oidc.client-id>
                                <quarkus.oidc.credentials.secret>quarkus-faces-secret</quarkus.oidc.credentials.secret>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <!-- Keep this profile LAST (see quarkus.profile below).
                 mvn verify -Dnative [-Pform|-Pbasic|-Poidc] : build a native executable and run the *IT tests against it.
                 Add -Dquarkus.native.container-build=true if GraalVM/Mandrel is not installed locally. -->
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
                <!-- Build the image with the mode profile only (prod, form, basic or oidc), not the "dev,..." used by
                     quarkus:dev. Works because this profile is declared last, so its properties win. -->
                <quarkus.profile>${app.profile}</quarkus.profile>
            </properties>
        </profile>
    </profiles>
</project>
