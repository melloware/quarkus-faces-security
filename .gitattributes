# Normalize all text files to LF in the repo and in working copies (Windows included)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files: never touch line endings or diff them as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
